---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/format';
import { publishedNews } from '../../lib/news';
import { wrap, lead, prose } from '../../lib/ui';

export async function getStaticPaths() {
  const posts = await publishedNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, date, excerpt, cover, cover_alt, attachments } = post.data;
const { Content } = await render(post);
---
<Base title={title} description={excerpt} image={cover}>
  <article class:list={[wrap, 'py-[clamp(2.5rem,7vw,5rem)]']}>
    <header class="max-w-measure">
      <a class="inline-block mb-6 font-semibold" href="/news">Tutte le news</a>
      <time class="block text-muted mb-2" datetime={date.toISOString()}>{formatDate(date)}</time>
      <h1>{title}</h1>
      {excerpt && <p class={lead}>{excerpt}</p>}
    </header>
    {cover && <img class="w-full max-h-[36rem] object-contain object-left mt-8 mb-10 rounded-brand" src={cover} alt={cover_alt ?? ''} />}
    <div class={prose}><Content /></div>
    {attachments && attachments.length > 0 && (
      <aside class="max-w-measure mt-12 border-t-[3px] border-ink pt-4">
        <h2 class="text-[1.6rem]">Allegati</h2>
        <ul class="list-disc pl-[1.2em]">{attachments.map((a) => <li><a href={a.file} download>{a.label}</a></li>)}</ul>
      </aside>
    )}
  </article>
</Base>
