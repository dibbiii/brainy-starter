---
// Tutte le altre pagine create nel CMS: /chi-siamo, /contatti, /privacy, …
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import PageHeader from '../components/PageHeader.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => p.id !== 'home');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { title, description, show_title, header_image, header_image_alt, sections = [] } = page.data;
const startsWithHero = sections?.[0]?.type === 'hero';
---
<Base title={title} description={description} hideFooterSponsors={sections?.some((s) => s.type === 'sponsors')}>
  {show_title && !startsWithHero && (
    <PageHeader title={title} description={description} image={header_image} imageAlt={header_image_alt} />
  )}
  <Blocks sections={sections ?? []} />
</Base>
