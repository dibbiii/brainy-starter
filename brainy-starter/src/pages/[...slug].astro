---
// Tutte le altre pagine create nel CMS: /chi-siamo, /contatti, /privacy, …
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import { wrap, segnavia } from '../lib/ui';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => p.id !== 'home');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { title, description, show_title, sections = [] } = page.data;
const startsWithHero = sections?.[0]?.type === 'hero';
---
<Base title={title} description={description} hideFooterSponsors={sections?.some((s) => s.type === 'sponsors')}>
  {show_title && !startsWithHero && (
    <header class:list={[wrap, 'pt-[clamp(2.5rem,7vw,5rem)] [&+.section]:pt-[clamp(1.5rem,4vw,2.5rem)]']}>
      <span class={segnavia} aria-hidden="true"></span>
      <h1 class="m-0">{title}</h1>
    </header>
  )}
  <Blocks sections={sections ?? []} />
</Base>
