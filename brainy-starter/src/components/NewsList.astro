---
import Base from '../layouts/Base.astro';
import NewsCard from './NewsCard.astro';
import { wrap, section, segnavia, lead } from '../lib/ui';
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'news'>[]; current: number; last: number }
const { posts, current, last } = Astro.props;
const href = (n: number) => (n === 1 ? '/news' : `/news/pagina/${n}`);
---
<Base title={current === 1 ? 'News' : `News – pagina ${current}`} description="Notizie, eventi e comunicazioni.">
  <div class:list={[wrap, section]}>
    <span class={segnavia} aria-hidden="true"></span>
    <h1>News</h1>
    {posts.length === 0
      ? <p class={lead}>Non ci sono ancora news. La prima si pubblica dal pannello Gestione contenuti.</p>
      : <div class="grid gap-x-gutter gap-y-12 grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] mt-8">{posts.map((post) => <NewsCard post={post} />)}</div>}
    {last > 1 && (
      <nav class="flex gap-8 justify-center mt-16 font-semibold" aria-label="Pagine delle news">
        {current > 1 && <a href={href(current - 1)}>Più recenti</a>}
        <span class="text-muted font-normal">Pagina {current} di {last}</span>
        {current < last && <a href={href(current + 1)}>Meno recenti</a>}
      </nav>
    )}
  </div>
</Base>
