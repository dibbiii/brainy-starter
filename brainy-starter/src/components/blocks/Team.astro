---
import { team } from "../../lib/site";
import { wrap, section, lead } from "../../lib/ui";
interface Props {
    title?: string;
    intro?: string;
    limit?: number;
    id?: string;
}
const { title, intro, limit = 0, id } = Astro.props;
const people = limit > 0 ? team.slice(0, limit) : team;
const initials = (n: string) =>
    n
        .split(/\s+/)
        .map((p) => p[0])
        .slice(0, 2)
        .join("");
---

<section class={section} id={id}>
    <div class={wrap}>
        {title && <h2>{title}</h2>}
        {intro && <p class={lead}>{intro}</p>}
        <ul class="grid gap-x-gutter gap-y-8 grid-cols-[repeat(auto-fill,minmax(12rem,1fr))] mt-8">
            {people.map((p) => (
                <li>
                    {p.photo ? (
                        <img class="w-full aspect-square object-cover rounded-brand mb-[0.9rem]" src={p.photo} alt="" loading="lazy" />
                    ) : (
                        <span class="grid place-items-center w-full aspect-square rounded-brand mb-[0.9rem] bg-tint font-heading text-5xl font-bold text-primary" aria-hidden="true">
                            {initials(p.name)}
                        </span>
                    )}
                    <h3 class="mb-[0.15rem]">{p.name}</h3>
                    <p class="text-accent font-semibold mb-[0.4rem]">{p.role}</p>
                    {p.bio && <p class="text-muted text-[0.97rem]">{p.bio}</p>}
                    {p.email && (
                        <p class="text-[0.92rem] mb-[0.4rem]">
                            <a class="text-muted hover:text-accent" href={`mailto:${p.email}`}>{p.email}</a>
                        </p>
                    )}
                </li>
            ))}
        </ul>
    </div>
</section>
