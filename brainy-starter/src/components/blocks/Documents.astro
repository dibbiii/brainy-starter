---
import { wrap, section } from '../../lib/ui';
interface Props { title?: string; files: { label: string; file: string }[]; id?: string }
const { title, files, id } = Astro.props;
const ext = (f: string) => f.split('.').pop()?.toUpperCase() ?? '';
---
<section class={section} id={id}>
  <div class={wrap}>
    {title && <h2>{title}</h2>}
    <ul class="mt-6 max-w-measure">
      {files.map((d) => (
        <li class="border-t border-line py-[0.9rem] flex justify-between gap-4 last:border-b"><a class="font-semibold" href={d.file} download>{d.label}</a> <span class="text-muted text-[0.85rem]">{ext(d.file)}</span></li>
      ))}
    </ul>
  </div>
</section>
