---
import SponsorList from '../SponsorList.astro';
interface Props { title?: string; intro?: string; id?: string }
const { title, intro, id } = Astro.props;
---
<section class="section section--tint" id={id}>
  <div class="wrap">
    {title && <h2>{title}</h2>}
    {intro && <p class="lead">{intro}</p>}
    <div style="margin-top:2rem"><SponsorList /></div>
  </div>
</section>
